# ===== Telegram =====
# Dapatkan token dari @BotFather, chat ID dari @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Sumber data (opsional) =====
# Bitget V2 API — default https://api.bitget.com (spot + futures dalam satu host).
# Kustomisasi hanya bila perlu (mirror/regional):
# BITGET_BASE_URL=https://api.bitget.com
# BITGET_FUTURES_URL=https://api.bitget.com

# CoinMarketCap free key (https://pro.coinmarketcap.com) — tier free: data delay,
# tanpa candle historis. Kosongkan bila tidak dipakai.
CMC_API_KEY=

# Etherscan / BscScan free key (whale transfer proxy)
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=

# ===== Cakupan scan =====
# Jumlah koin teratas yang dipindai (maks 250; bila CMC kosong, dipilih by volume Bitget)
TOP_COINS=250
# Jumlah sinyal yang ditampilkan di Daily Briefing
TOP_SIGNALS=5
# Volume minimum 24j (USD) agar koin dipertimbangkan
MIN_VOLUME_USD=500000

# ===== Ambang sinyal & bobot =====
# Skor akhir berkisar -1.0..+1.0
BUY_THRESHOLD=0.10
SELL_THRESHOLD=-0.10
CONFIDENCE_BASE=55

# Bobot kategori (jumlah harus ~1.00) — S&R sebagai kompas utama
WEIGHT_SR=0.35
WEIGHT_SMC=0.20
WEIGHT_FIBO=0.15
WEIGHT_EMA=0.15
WEIGHT_TECHNICAL=0.08
WEIGHT_ONCHAIN=0.05
WEIGHT_SENTIMENT=0.02

# ===== On-chain / whale =====
# Transfer dianggap "whale" bila di atas ambang USD ini
WHALE_MIN_USD=5000000
WHALE_LOOKBACK_HOURS=24

# ===== Fear & Greed =====
FEAR_GREED_LOOKBACK=7
